{
  "name": "@novachat-enterprise-erp/realtime-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@novachat-enterprise-erp/cache": "^0.1.0",
    "@novachat-enterprise-erp/common": "^0.1.0",
    "@novachat-enterprise-erp/contracts": "^0.1.0",
    "@novachat-enterprise-erp/events": "^0.1.0",
    "@socket.io/redis-adapter": "8.3.0",
    "express": "5.3.0",
    "ioredis": "5.11.1",
    "socket.io": "4.8.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@novachat-enterprise-erp/testing": "^0.1.0",
    "@novachat-enterprise-erp/tsconfig": "^0.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.12"
  }
}
